+class WCVideoLayerManager::VideoLayer final : public WebCore::TextureMapperPlatformLayer {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(VideoLayer);
+public:
+    void setFrame(Frame&& frame) { m_frame = WTF::move(frame); }
+    HashCountedSet<WCScene*>& scenes() { return m_scenes; }
+
+    void paintToTextureMapper(WebCore::TextureMapper& textureMapper, const WebCore::FloatRect& targetRect, const WebCore::TransformationMatrix& modelViewMatrix, float opacity) final
+    {
+        // Uploaded here, with the painting scene's GL context current.
+        if (m_frame && m_frame->memory) {
+            if (!m_texture || m_texture->size() != m_frame->size)
+                m_texture = WebCore::BitmapTexture::create(m_frame->size);
+            m_texture->updateContents(m_frame->memory->span().data(), WebCore::IntRect({ }, m_frame->size), WebCore::IntPoint(), m_frame->bytesPerRow, WebCore::PixelFormat::BGRA8);
+        }
+        m_frame = std::nullopt;
+        if (m_texture)
+            textureMapper.drawTexture(*m_texture, targetRect, modelViewMatrix, opacity);
+    }
+
+private:
+    std::optional<Frame> m_frame;
+    RefPtr<WebCore::BitmapTexture> m_texture;
+    HashCountedSet<WCScene*> m_scenes;
+};
+
+WCVideoLayerManager& WCVideoLayerManager::singleton()
+{
+    static NeverDestroyed<WCVideoLayerManager> manager;
+    return manager;
+}
+
+void WCVideoLayerManager::pushFrame(WebCore::ProcessIdentifier process, uint64_t videoLayer, Ref<WebCore::SharedMemory>&& memory, const WebCore::IntSize& size, uint32_t bytesPerRow)
+{
+    if (!videoLayer)
+        return;
+    bool alreadyOnItsWay;
+    {
+        Locker locker { m_pendingLock };
+        auto& frames = m_pending.ensure(process, [] {
+            return HashMap<uint64_t, Frame> { };
+        }).iterator->value;
+        // A frame that hasn't reached the compositing thread yet is replaced:
+        // only the newest is worth showing.
+        alreadyOnItsWay = !frames.set(videoLayer, Frame { WTF::move(memory), size, bytesPerRow }).isNewEntry;
+    }
+    if (alreadyOnItsWay)
+        return;
+    remoteGraphicsStreamWorkQueue().dispatch([process, videoLayer] {
+        WCVideoLayerManager::singleton().deliver(process, videoLayer);
+    });
+}
+
+void WCVideoLayerManager::deliver(WebCore::ProcessIdentifier process, uint64_t videoLayer)
+{
+    std::optional<Frame> frame;
+    {
+        Locker locker { m_pendingLock };
+        auto frames = m_pending.find(process);
+        if (frames != m_pending.end()) {
+            auto found = frames->value.find(videoLayer);
+            if (found != frames->value.end()) {
+                frame = WTF::move(found->value);
+                frames->value.remove(found);
+            }
+        }
+    }
+    if (!frame)
+        return;
+    auto& layer = ensureLayer(process, videoLayer);
+    layer.setFrame(WTF::move(*frame));
+    for (auto* scene : copyToVector(layer.scenes().values()))
+        scene->recomposite();
+}
+
+WCVideoLayerManager::VideoLayer& WCVideoLayerManager::ensureLayer(WebCore::ProcessIdentifier process, uint64_t videoLayer)
+{
+    auto& layers = m_layers.ensure(process, [] {
+        return VideoLayers { };
+    }).iterator->value;
+    return *layers.ensure(videoLayer, [] {
+        return makeUnique<VideoLayer>();
+    }).iterator->value;
+}
+
+void WCVideoLayerManager::release(WebCore::ProcessIdentifier process, uint64_t videoLayer)
+{
+    {
+        Locker locker { m_pendingLock };
+        auto frames = m_pending.find(process);
+        if (frames != m_pending.end())
+            frames->value.remove(videoLayer);
+    }
+    remoteGraphicsStreamWorkQueue().dispatch([process, videoLayer] {
+        auto& manager = WCVideoLayerManager::singleton();
+        auto layers = manager.m_layers.find(process);
+        if (layers == manager.m_layers.end())
+            return;
+        auto layer = layers->value.take(videoLayer);
+        if (layer)
+            manager.removeLayer(process, videoLayer, WTF::move(layer));
+    });
+}
+
+void WCVideoLayerManager::removeLayer(WebCore::ProcessIdentifier, uint64_t videoLayer, std::unique_ptr<VideoLayer>&& layer)
+{
+    // The scenes stop showing it before it goes.
+    for (auto* scene : copyToVector(layer->scenes().values()))
+        scene->videoLayerRemoved(videoLayer);
+}
+
+WebCore::TextureMapperPlatformLayer* WCVideoLayerManager::attach(WebCore::ProcessIdentifier process, uint64_t videoLayer, WCScene& scene)
+{
+    auto& layer = ensureLayer(process, videoLayer);
+    layer.scenes().add(&scene);
+    return &layer;
+}
+
+void WCVideoLayerManager::detach(WebCore::ProcessIdentifier process, uint64_t videoLayer, WCScene& scene)
+{
+    auto layers = m_layers.find(process);
+    if (layers == m_layers.end())
+        return;
+    auto layer = layers->value.find(videoLayer);
+    if (layer != layers->value.end())
+        layer->value->scenes().remove(&scene);
+}
+
+void WCVideoLayerManager::removeAllForProcess(WebCore::ProcessIdentifier process)
+{
+    {
+        Locker locker { m_pendingLock };
+        m_pending.remove(process);
+    }
+    auto layers = m_layers.take(process);
+    for (auto& entry : layers)
+        removeLayer(process, entry.key, WTF::move(entry.value));
+}
+
+} // namespace WebKit
+
+#endif // USE(GRAPHICS_LAYER_WC)

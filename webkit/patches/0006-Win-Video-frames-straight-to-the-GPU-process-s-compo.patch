+namespace {
+
+// The video element's layer: frames come from WCVideoLayerManager in the
+// GPU process, which knows it by this identifier.
+class WCVideoPlatformLayer final : public WebCore::WCPlatformLayer {
+public:
+    explicit WCVideoPlatformLayer(uint64_t identifier)
+        : m_identifier(identifier)
+    {
+    }
+
+    std::optional<uint64_t> videoLayerIdentifier() const final { return m_identifier; }
+
+private:
+    uint64_t m_identifier;
+};
+
+class WCVideoFrameSinkProxy final : public WebCore::WCVideoFrameSink {
+public:
+    static RefPtr<WebCore::WCVideoFrameSink> create()
+    {
+        ASSERT(isMainThread());
+        static uint64_t nextIdentifier = 1;
+        Ref connection = WebProcess::singleton().ensureGPUProcessConnection().connection();
+        return adoptRef(*new WCVideoFrameSinkProxy(nextIdentifier++, WTF::move(connection)));
+    }
+
+    ~WCVideoFrameSinkProxy()
+    {
+        m_connection->send(Messages::GPUConnectionToWebProcess::ReleaseWCVideoLayer(m_identifier), 0);
+    }
+
+    WebCore::TextureMapperPlatformLayer* platformLayer() final { return &m_layer; }
+
+    // On the media backend's streaming thread: one copy into shared memory,
+    // then the GPU process has it.
+    bool pushFrame(std::span<const uint8_t> pixels, const WebCore::IntSize& size, unsigned bytesPerRow) final
+    {
+        if (size.isEmpty())
+            return false;
+        size_t rowBytes = static_cast<size_t>(size.width()) * 4;
+        size_t height = static_cast<size_t>(size.height());
+        if (bytesPerRow < rowBytes || pixels.size() < bytesPerRow * (height - 1) + rowBytes)
+            return false;
+        RefPtr memory = WebCore::SharedMemory::allocate(rowBytes * height);
+        if (!memory)
+            return false;
+        auto destination = memory->mutableSpan();
+        for (size_t y = 0; y < height; ++y)
+            memcpySpan(destination.subspan(y * rowBytes, rowBytes), pixels.subspan(y * bytesPerRow, rowBytes));
+        auto handle = memory->createHandle(WebCore::SharedMemory::Protection::ReadOnly);
+        if (!handle)
+            return false;
+        m_connection->send(Messages::GPUConnectionToWebProcess::PushWCVideoFrame(m_identifier, WTF::move(*handle), size, static_cast<uint32_t>(rowBytes)), 0);
+        return true;
+    }
+
+private:
+    WCVideoFrameSinkProxy(uint64_t identifier, Ref<IPC::Connection>&& connection)
+        : m_identifier(identifier)
+        , m_layer(identifier)
+        , m_connection(WTF::move(connection))
+    {
+    }
+
+    const uint64_t m_identifier;
+    WCVideoPlatformLayer m_layer;
+    const Ref<IPC::Connection> m_connection;
+};
+
+bool s_offscreenRenderingInProcess = false;
+
+} // namespace
+
+void registerWCVideoFrameSinkFactory(bool usesOffscreenRendering)
+{
+    ASSERT(isMainThread());
+    if (usesOffscreenRendering)
+        s_offscreenRenderingInProcess = true;
+    WebCore::WCVideoFrameSink::setFactory([]() -> RefPtr<WebCore::WCVideoFrameSink> {
+        // WEBKIT_WC_VIDEO_LAYER=0 turns it off: frames are painted by the page.
+        static const bool disabled = [] {
+            const char* value = getenv("WEBKIT_WC_VIDEO_LAYER");
+            return value && !strcmp(value, "0");
+        }();
+        if (disabled || s_offscreenRenderingInProcess)
+            return nullptr;
+        return WCVideoFrameSinkProxy::create();
+    });
+}
+
 } // namespace WebKit
 
 #endif // USE(GRAPHICS_LAYER_WC)

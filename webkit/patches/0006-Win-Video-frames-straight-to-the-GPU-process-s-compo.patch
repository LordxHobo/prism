+class WCScene;
+
+// Videos whose frames the web process sends straight here (a media player's
+// WCVideoFrameSink, see RemoteWCLayerTreeHostProxy.cpp), each a platform
+// layer the scenes show. A new frame recomposites the scenes showing it
+// right away, without waiting for the page's next rendering update, so a
+// busy page doesn't hold the video back.
+class WCVideoLayerManager {
+public:
+    static WCVideoLayerManager& singleton();
+
+    // The GPU process's main thread (IPC from the web process).
+    void pushFrame(WebCore::ProcessIdentifier, uint64_t videoLayer, Ref<WebCore::SharedMemory>&&, const WebCore::IntSize&, uint32_t bytesPerRow);
+    void release(WebCore::ProcessIdentifier, uint64_t videoLayer);
+
+    // The compositing thread (remoteGraphicsStreamWorkQueue()).
+    WebCore::TextureMapperPlatformLayer* attach(WebCore::ProcessIdentifier, uint64_t videoLayer, WCScene&);
+    void detach(WebCore::ProcessIdentifier, uint64_t videoLayer, WCScene&);
+    void removeAllForProcess(WebCore::ProcessIdentifier);
+
+private:
+    struct Frame {
+        RefPtr<WebCore::SharedMemory> memory;
+        WebCore::IntSize size;
+        uint32_t bytesPerRow { 0 };
+    };
+    class VideoLayer;
+    using VideoLayers = HashMap<uint64_t, std::unique_ptr<VideoLayer>>;
+
+    void deliver(WebCore::ProcessIdentifier, uint64_t videoLayer);
+    VideoLayer& ensureLayer(WebCore::ProcessIdentifier, uint64_t videoLayer);
+    void removeLayer(WebCore::ProcessIdentifier, uint64_t videoLayer, std::unique_ptr<VideoLayer>&&);
+
+    // The compositing thread only.
+    HashMap<WebCore::ProcessIdentifier, VideoLayers> m_layers;
+
+    // Frames on their way to the compositing thread: the newest per video.
+    Lock m_pendingLock;
+    HashMap<WebCore::ProcessIdentifier, HashMap<uint64_t, Frame>> m_pending WTF_GUARDED_BY_LOCK(m_pendingLock);
+};
+
+} // namespace WebKit

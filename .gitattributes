# Normalize line endings in the repository; check out Windows scripts with CRLF.
* text=auto
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.rc text eol=crlf
*.ico binary
*.png binary
# WebKit patches must keep their exact bytes (LF), or git apply fails on them.
webkit/patches/*.patch -text
*.mem binary
*.wasm binary

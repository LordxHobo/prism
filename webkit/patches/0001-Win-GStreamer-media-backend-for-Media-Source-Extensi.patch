diff --git a/Source/cmake/GStreamerWin.cmake b/Source/cmake/GStreamerWin.cmake
new file mode 100644
index 000000000..5412f726d
--- /dev/null
+++ b/Source/cmake/GStreamerWin.cmake
@@ -0,0 +1,95 @@
+# GStreamer (and the GLib it is built on) for the Windows port, taken from
+# GStreamer's MSVC development files rather than pkg-config: those files also
+# carry zlib, libxml2, libpng and friends, and pkg-config hints would make
+# CMake pick them over the vcpkg builds the rest of WebKit uses. Only the
+# gstreamer-1.0 and glib-2.0 header folders are added to the include path.
+
+if (NOT GSTREAMER_ROOT)
+    if (DEFINED ENV{GSTREAMER_ROOT})
+        set(GSTREAMER_ROOT "$ENV{GSTREAMER_ROOT}")
+    elseif (DEFINED ENV{GSTREAMER_1_0_ROOT_MSVC_X86_64})
+        set(GSTREAMER_ROOT "$ENV{GSTREAMER_1_0_ROOT_MSVC_X86_64}")
+    endif ()
+endif ()
+if (NOT GSTREAMER_ROOT OR NOT EXISTS "${GSTREAMER_ROOT}/include/gstreamer-1.0/gst/gst.h")
+    message(FATAL_ERROR "USE_GSTREAMER needs GStreamer's MSVC development files. Set GSTREAMER_ROOT to the folder that has include\\gstreamer-1.0 (was '${GSTREAMER_ROOT}').")
+endif ()
+file(TO_CMAKE_PATH "${GSTREAMER_ROOT}" GSTREAMER_ROOT)
+message(STATUS "GStreamer: ${GSTREAMER_ROOT}")
+
+set(GLIB_INCLUDE_DIRS
+    "${GSTREAMER_ROOT}/include/glib-2.0"
+    "${GSTREAMER_ROOT}/lib/glib-2.0/include"
+)
+set(_gst_include_dirs "${GSTREAMER_ROOT}/include/gstreamer-1.0" ${GLIB_INCLUDE_DIRS})
+
+function(_gst_win_find_library _variable _name)
+    find_library(${_variable} NAMES ${_name} PATHS "${GSTREAMER_ROOT}/lib" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
+    if (NOT ${_variable})
+        message(FATAL_ERROR "GStreamer library ${_name}.lib not found in ${GSTREAMER_ROOT}/lib")
+    endif ()
+endfunction()
+
+# Same targets as FindGLib.cmake.
+function(_gst_win_glib_target _target _name)
+    _gst_win_find_library(GLIB_WIN_${_name}_LIBRARY ${_name})
+    if (NOT TARGET ${_target})
+        add_library(${_target} UNKNOWN IMPORTED GLOBAL)
+        set_target_properties(${_target} PROPERTIES
+            IMPORTED_LOCATION "${GLIB_WIN_${_name}_LIBRARY}"
+            INTERFACE_INCLUDE_DIRECTORIES "${GLIB_INCLUDE_DIRS}"
+        )
+    endif ()
+endfunction()
+
+_gst_win_glib_target(GLib::GLib glib-2.0)
+_gst_win_glib_target(GLib::Object gobject-2.0)
+_gst_win_glib_target(GLib::Module gmodule-2.0)
+_gst_win_glib_target(GLib::Gio gio-2.0)
+set_property(TARGET GLib::Object APPEND PROPERTY INTERFACE_LINK_LIBRARIES GLib::GLib)
+set_property(TARGET GLib::Gio APPEND PROPERTY INTERFACE_LINK_LIBRARIES GLib::Object)
+set(GLib_FOUND TRUE)
+
+# The variables FindGStreamer.cmake sets, as platform/GStreamer.cmake uses them.
+foreach (_component
+        "GSTREAMER;gstreamer-1.0"
+        "GSTREAMER_BASE;gstbase-1.0"
+        "GSTREAMER_ALLOCATORS;gstallocators-1.0"
+        "GSTREAMER_APP;gstapp-1.0"
+        "GSTREAMER_AUDIO;gstaudio-1.0"
+        "GSTREAMER_PBUTILS;gstpbutils-1.0"
+        "GSTREAMER_TAG;gsttag-1.0"
+        "GSTREAMER_VIDEO;gstvideo-1.0")
+    list(GET _component 0 _prefix)
+    list(GET _component 1 _library)
+    _gst_win_find_library(${_prefix}_LIBRARIES ${_library})
+    set(${_prefix}_INCLUDE_DIRS ${_gst_include_dirs})
+    set(PC_${_prefix}_FOUND TRUE)
+endforeach ()
+
+if (ENABLE_WEB_AUDIO)
+    _gst_win_find_library(GSTREAMER_FFT_LIBRARIES gstfft-1.0)
+    set(GSTREAMER_FFT_INCLUDE_DIRS ${_gst_include_dirs})
+    set(PC_GSTREAMER_FFT_FOUND TRUE)
+endif ()
+
+file(STRINGS "${GSTREAMER_ROOT}/include/gstreamer-1.0/gst/gstversion.h" _gst_version_lines REGEX "#define GST_VERSION_(MAJOR|MINOR|MICRO) ")
+foreach (_line IN LISTS _gst_version_lines)
+    string(REGEX REPLACE ".*#define GST_VERSION_([A-Z]+) +\\(?([0-9]+).*" "\\1;\\2" _pair "${_line}")
+    list(GET _pair 0 _part)
+    list(GET _pair 1 _number)
+    set(_gst_version_${_part} ${_number})
+endforeach ()
+set(GSTREAMER_VERSION "${_gst_version_MAJOR}.${_gst_version_MINOR}.${_gst_version_MICRO}")
+if (GSTREAMER_VERSION VERSION_LESS 1.20.0)
+    message(FATAL_ERROR "GStreamer 1.20 or newer is needed, found ${GSTREAMER_VERSION}")
+endif ()
+message(STATUS "GStreamer version: ${GSTREAMER_VERSION}")
+
+# No GL sink (WebKit's Windows compositor paints video frames itself), no
+# MPEG-TS metadata, no static GStreamer.
+SET_AND_EXPOSE_TO_BUILD(USE_GSTREAMER_GL OFF)
+SET_AND_EXPOSE_TO_BUILD(USE_GSTREAMER_MPEGTS OFF)
+SET_AND_EXPOSE_TO_BUILD(USE_GSTREAMER_FULL OFF)
+SET_AND_EXPOSE_TO_BUILD(ENABLE_MEDIA_TELEMETRY OFF)
+SET_AND_EXPOSE_TO_BUILD(USE_LIBWEBRTC OFF)

+void WCScene::recomposite()
+{
+    // Offscreen rendering hands its pixels back to the web process with an
+    // update; a remote frame's scene is drawn by its host. Those wait for
+    // the next update.
+    if (!m_canRecomposite || !m_rootLayer || !m_context || !m_textureMapper || m_viewport.isEmpty())
+        return;
+    auto* root = m_layers.get(*m_rootLayer);
+    if (!root || !m_context->makeContextCurrent())
+        return;
+    root->texmapLayer.applyAnimationsRecursively(MonotonicTime::now());
+    glViewport(0, 0, m_viewport.width(), m_viewport.height());
+    m_textureMapper->beginPainting(WebCore::TextureMapper::FlipY::No, nullptr);
+    root->texmapLayer.paint(*m_textureMapper);
+    m_fpsCounter.updateFPSAndDisplay(*m_textureMapper);
+    m_textureMapper->endPainting();
+    m_context->swapBuffers();
+}
+
+void WCScene::videoLayerRemoved(uint64_t videoLayer)
+{
+    for (auto& layer : m_layers.values()) {
+        if (layer->videoLayer == videoLayer) {
+            layer->videoLayer = 0;
+            layer->texmapLayer.setContentsLayer(nullptr);
+        }
+    }
+}
+
 } // namespace WebKit
 

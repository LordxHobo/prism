+#if !USE(COORDINATED_GRAPHICS) && USE(GRAPHICS_LAYER_WC)
+// On the streaming thread: the newest frame, to the GPU process.
+void MediaPlayerPrivateGStreamer::pushFrameToWCCompositor()
+{
+    RefPtr sink = m_wcVideoSink;
+    if (!sink)
+        return;
+    GRefPtr<GstSample> sample;
+    {
+        Locker sampleLocker { m_sampleMutex };
+        sample = m_sample;
+    }
+    if (!sample)
+        return;
+    GstMappedFrame frame(sample, GST_MAP_READ);
+    if (!frame) {
+        GST_WARNING_OBJECT(pipeline(), "Couldn't map a video frame for the compositor");
+        return;
+    }
+    auto format = static_cast<GstVideoFormat>(frame.format());
+    if (format != GST_VIDEO_FORMAT_BGRx && format != GST_VIDEO_FORMAT_BGRA) {
+        GST_WARNING_OBJECT(pipeline(), "Video frame format %s can't go to the compositor", gst_video_format_to_string(format));
+        return;
+    }
+    if (!sink->pushFrame(frame.planeData(0), IntSize(frame.width(), frame.height()), frame.planeStride(0)))
+        GST_WARNING_OBJECT(pipeline(), "Couldn't send a video frame to the compositor");
+}
+#endif

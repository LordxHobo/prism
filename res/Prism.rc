#include <windows.h>
#include "../src/Version.h"

// The "Facet" logo: Amber (1, also the file's own icon) for a light
// taskbar, Ocean (2) for a dark one (util::appIcon picks).
1 ICON "prism.ico"
2 ICON "prism-dark.ico"
1 RT_MANIFEST "Prism.exe.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PRISM_VERSION_MAJOR, PRISM_VERSION_MINOR, PRISM_VERSION_PATCH, 0
PRODUCTVERSION PRISM_VERSION_MAJOR, PRISM_VERSION_MINOR, PRISM_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Prism contributors"
            VALUE "FileDescription", "Prism"
            VALUE "FileVersion", PRISM_VERSION_STRING
            VALUE "InternalName", "Prism"
            VALUE "LegalCopyright", "Mozilla Public License 2.0"
            VALUE "OriginalFilename", "Prism.exe"
            VALUE "ProductName", "Prism"
            VALUE "ProductVersion", PRISM_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

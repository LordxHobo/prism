From b4e138d8eb2d1643cc21cfef9bb1425f8b7f54c8 Mon Sep 17 00:00:00 2001
From: Prism <prism@users.noreply.github.com>
Date: Fri, 27 Nov 2026 21:28:02 +0100
Subject: [PATCH] [Win] Don't crash painting a WebView when Skia can't make a
 surface

WebView::paint() (Skia) used SkSurfaces::Raster()'s result without checking
it. Prism crashed in the UI process when it was null (getCanvas() on a null
surface), seen while restoring the window. Paint the background instead.
---
 Source/WebKit/UIProcess/win/WebView.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Source/WebKit/UIProcess/win/WebView.cpp b/Source/WebKit/UIProcess/win/WebView.cpp
index 038b53502..4067b0719 100644
--- a/Source/WebKit/UIProcess/win/WebView.cpp
+++ b/Source/WebKit/UIProcess/win/WebView.cpp
@@ -511,6 +511,13 @@ void WebView::paint(HDC hdc, const IntRect& dirtyRect)
             scaledRect.scale(intrinsicDeviceScaleFactor);
             auto info = SkImageInfo::MakeN32Premul(scaledRect.width(), scaledRect.height(), SkColorSpace::MakeSRGB());
             auto surface = SkSurfaces::Raster(info);
+            if (!surface) {
+                // Skia couldn't make the surface (out of memory, or a size it
+                // won't take while the window is being restored): draw the
+                // background instead of crashing; the next paint draws the page.
+                drawPageBackground(hdc, m_page.get(), dirtyRect);
+                return;
+            }
             auto canvas = surface->getCanvas();
             canvas->scale(intrinsicDeviceScaleFactor, intrinsicDeviceScaleFactor);
             canvas->translate(-dirtyRect.x(), -dirtyRect.y());
-- 

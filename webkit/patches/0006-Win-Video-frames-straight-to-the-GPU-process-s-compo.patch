+// A video frame from a media player (BGRA, see WCVideoFrameSink).
+void GPUConnectionToWebProcess::pushWCVideoFrame(uint64_t videoLayer, WebCore::SharedMemory::Handle&& handle, const WebCore::IntSize& size, uint32_t bytesPerRow)
+{
+    if (!videoLayer || size.isEmpty() || size.width() > 16384 || size.height() > 16384 || bytesPerRow < static_cast<uint32_t>(size.width()) * 4)
+        return;
+    RefPtr memory = WebCore::SharedMemory::map(WTF::move(handle), WebCore::SharedMemory::Protection::ReadOnly);
+    if (!memory || memory->size() < static_cast<size_t>(bytesPerRow) * static_cast<size_t>(size.height()))
+        return;
+    WCVideoLayerManager::singleton().pushFrame(m_webProcessIdentifier, videoLayer, memory.releaseNonNull(), size, bytesPerRow);
+}
+
+void GPUConnectionToWebProcess::releaseWCVideoLayer(uint64_t videoLayer)
+{
+    WCVideoLayerManager::singleton().release(m_webProcessIdentifier, videoLayer);
+}
 #endif
 

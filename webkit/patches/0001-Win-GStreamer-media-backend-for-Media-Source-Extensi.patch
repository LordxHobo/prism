+#if OS(WINDOWS)
+// gst_bus_add_signal_watch() attaches a GSource to GLib's default main
+// context. GTK and WPE run that context as their main loop; on Windows the
+// main loop is a Win32 message loop, so dispatch the context from a timer.
+static void ensureGLibMainContextIsDispatched()
+{
+    ensureOnMainThread([] {
+        static NeverDestroyed<std::unique_ptr<RunLoop::Timer>> timer;
+        if (timer.get())
+            return;
+        timer.get() = makeUnique<RunLoop::Timer>(RunLoop::mainSingleton(), "GLibMainContextDispatch"_s, [] {
+            auto* context = g_main_context_default();
+            for (unsigned i = 0; i < 100 && g_main_context_iteration(context, FALSE); ++i) { }
+        });
+        timer.get()->startRepeating(8_ms);
+    });
+}
+#endif

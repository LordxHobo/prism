-} // namespace WebKit
+// Sends a video's frames straight to the compositor in the GPU process, from
+// the media backend's own thread: the page's main thread doesn't draw them,
+// and the GPU process shows each one as it arrives. WebKit provides it
+// (RemoteWCLayerTreeHostProxy.cpp); the media player asks for one.
+class WCVideoFrameSink : public ThreadSafeRefCounted<WCVideoFrameSink> {
+public:
+    using Factory = RefPtr<WCVideoFrameSink> (*)();
+    static void setFactory(Factory factory) { s_factory = factory; }
+    static RefPtr<WCVideoFrameSink> create() { return s_factory ? s_factory() : nullptr; }
+
+    virtual ~WCVideoFrameSink() = default;
+    // For the video element's GraphicsLayer (main thread).
+    virtual TextureMapperPlatformLayer* platformLayer() = 0;
+    // A BGRx/BGRA frame (any thread). False if it couldn't be sent.
+    virtual bool pushFrame(std::span<const uint8_t> pixels, const IntSize&, unsigned bytesPerRow) = 0;
+
+private:
+    static inline Factory s_factory { nullptr };
+};
+
+} // namespace WebCore
